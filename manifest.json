{
  "manifest_version": 2,
  "name": "yt-time-cal-tracker",
  "version": "0.2",
  "description": "track time on youtube with google calendar, filter low-quality videos and score views/time",
  "permissions": [
    "storage",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "*://www.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js", "config.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "feature-flags.js",
        "content/core.js",
        "content/feedback.js",
        "content/features/time-tracker.js",
        "content/features/quality-filter.js",
        "content/features/score-badge.js",
        "content/features/watch-stats.js",
        "content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "assets/image-48x48-20260627151302.png",
    "96": "assets/image-96x96-20260627151304.png"
  }
}
